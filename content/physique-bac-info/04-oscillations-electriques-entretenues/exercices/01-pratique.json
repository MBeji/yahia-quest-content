    {
      "prompt": "Un dipôle D inséré dans un circuit RLC a une tension u = −R·i, avec un signe moins. Que signifie ce signe ?",
      "options": [
        {
          "id": "a",
          "text": "Le courant le traverse à contresens du courant du reste du circuit"
        },
        {
          "id": "b",
          "text": "Sa valeur est simplement plus petite que celle d'un résistor ordinaire"
        },
        {
          "id": "c",
          "text": "Il dissipe encore plus d'énergie qu'un résistor de même résistance"
        },
        {
          "id": "d",
          "text": "Sa tension est opposée à celle d'un résistor : il fournit de l'énergie"
        }
      ],
      "correctOption": "d",
      "explanation": "Un résistor donne u = +R·i et dissipe de l'énergie ; un dipôle de tension u = −R·i a une tension opposée, donc il fournit de l'énergie au circuit ✓. Le courant est le même en tout point d'un circuit série. Une résistance « plus petite » resterait positive, et un dipôle qui dissipe davantage amortirait plus au lieu de compenser.",
      "difficulty": 1
    },
