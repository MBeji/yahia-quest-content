    {
      "type": "numeric",
      "prompt": "Un RLC série (R = 150 Ω, L = 0,40 H, C = 2,0 µF) est alimenté à la fréquence N = 100 Hz. Calculer son facteur de puissance cos φ, arrondi au centième.",
      "answerKey": {
        "value": 0.27,
        "tolerance": 0.01
