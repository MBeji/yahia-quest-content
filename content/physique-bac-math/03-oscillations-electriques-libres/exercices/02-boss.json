stroke=\"#ffffff\" stroke-width=\"1.2\"/><circle cx=\"134\" cy=\"66\" r=\"4\" fill=\"#ea580c\" stroke=\"#ffffff\" stroke-width=\"1.2\"/><text x=\"170\" y=\"233\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#0f172a\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"3.5\" stroke-linejoin=\"round\">balayage : 2 ms/div</text><text x=\"170\" y=\"251\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#0f172a\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"3.5\" stroke-linejoin=\"round\">sensibilité : 5 V/div</text><text x=\"65\" y=\"121\" text-anchor=\"end\" font-size=\"12\" font-weight=\"700\" fill=\"#0f172a\" paint-order=\"stroke\" stroke=\"#ffffff\" stroke-width=\"3.5\" stroke-linejoin=\"round\">0</text></svg>",
